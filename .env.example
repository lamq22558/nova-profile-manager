# NOVA Profile Manager Configuration

# API Settings
NOVA_API_HOST=127.0.0.1
NOVA_API_PORT=54345
NOVA_API_DEBUG=false

# Browser Settings
NOVA_CHROMIUM_PATH=
NOVA_BROWSER_TIMEOUT=30
NOVA_BROWSER_MAX_INSTANCES=10

# Proxy Settings
NOVA_PROXY_TIMEOUT=10
NOVA_PROXY_CHECK_INTERVAL=300
NOVA_PROXY_RETRY_COUNT=3

# Database Settings
NOVA_DB_BACKUP_ENABLED=true
NOVA_DB_BACKUP_INTERVAL=3600
NOVA_DB_ENCRYPTION_KEY=

# Logging Settings
NOVA_LOG_LEVEL=INFO
NOVA_LOG_MAX_SIZE=10485760
NOVA_LOG_BACKUP_COUNT=5

# Cloud Integration (Optional)
NOVA_CLOUD_PROVIDER=
NOVA_CLOUD_API_KEY=
NOVA_CLOUD_BUCKET=

# Notification Settings
NOVA_SLACK_WEBHOOK=
NOVA_TELEGRAM_TOKEN=
NOVA_TELEGRAM_CHAT_ID=
NOVA_EMAIL_ENABLED=false
NOVA_EMAIL_SMTP_HOST=
NOVA_EMAIL_SMTP_PORT=587
NOVA_EMAIL_SENDER=
